# LeadPulse CRM — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Local (Docker):
DATABASE_URL=postgresql://leadpulse:leadpulse@localhost:5432/leadpulse?schema=public
# Supabase production example:
# DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-256-bit-string
JWT_EXPIRES_IN=7d

# ── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5001

# ── AI APIs ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Optional Integrations ─────────────────────────────────────────────────────
CLEARBIT_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Nightly Scoring Job ───────────────────────────────────────────────────────
# Cron expression for nightly scoring (default: 2 AM IST)
SCORING_CRON=0 2 * * *
TZ=Asia/Kolkata

# ── Client (Vite) ─────────────────────────────────────────────────────────────
# These go in client/.env (not this file)
# VITE_API_URL=http://localhost:3001
# VITE_SOCKET_URL=http://localhost:3001
