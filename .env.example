# LeadPulse CRM — Environment Variables
# Copy to .env and fill in values. NEVER commit .env.

# ── Runtime ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173            # used in invite links
CORS_ORIGINS=http://localhost:5173       # comma-separated exact origins
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────
# Matches docker-compose.yml. Inside compose the host is overridden to "postgres".
DATABASE_URL=postgresql://leadpulse:leadpulse_secret@localhost:5432/leadpulse_db?schema=public
DB_POOL_MAX=10
# Supabase (cloud): use the Session pooler URL (port 5432, IPv4) and DB_POOL_MAX=5
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Redis / background jobs ─────────────────────────────────────
REDIS_URL=redis://localhost:6379        # compose overrides this with redis://redis:6379; unset = jobs run in the API
WORKER_INLINE=false                      # true on Render free tier (no background workers)
WORKER_CONCURRENCY=4
SCORING_CRON=0 2 * * *                   # local repeatable nightly job; cloud uses GitHub Actions cron
TZ=Asia/Kolkata

# ── Auth ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@leadpulse.dev  # the only email allowed to self-register as ADMIN
ALLOW_SIGNUP=false                       # true lets anyone register as SALES_REP

# ── Secrets / internal (generate random values) ─────────────────
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=                          # 32 bytes base64 (openssl rand -base64 32) — encrypts API keys saved in Settings and webhook secrets
INTERNAL_JOB_TOKEN=                      # protects POST /internal/jobs/nightly
STORAGE_SIGNING_KEY=                     # signs local file download URLs

# ── ML service ──────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5001
ML_SERVICE_TOKEN=change-me-shared-secret # required header X-ML-Token
FLASK_PORT=5001

# ── AI providers — free-first chain (Gemini Flash → Flash-Lite → Groq → OpenRouter) ─
# Keys can also be saved in Settings → Integrations. A provider whose daily quota is spent is skipped until it resets.
AI_MOCK=false                            # true in CI/e2e: deterministic fake provider
AI_PROVIDER_ORDER=gemini,gemini-lite,groq,openrouter,anthropic,openai
GEMINI_API_KEY=                          # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite  # same key; its own (larger) free quota
GROQ_API_KEY=                            # https://console.groq.com
GROQ_MODEL=openai/gpt-oss-120b
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=                      # https://openrouter.ai
OPENROUTER_MODEL=google/gemma-4-31b-it:free  # any current ":free" model id
ANTHROPIC_API_KEY=                       # optional — auto-enabled when set
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=                          # optional — auto-enabled when set
OPENAI_MODEL=gpt-4o-mini
AI_RATE_PER_MIN=30
AI_RATE_PER_DAY=500
NBA_BATCH_SIZE=20

# ── Enrichment (optional) ───────────────────────────────────────
CLEARBIT_API_KEY=

# ── Email ───────────────────────────────────────────────────────
EMAIL_DRIVER=ethereal                    # ethereal (dev) | smtp | resend (prod; Render blocks SMTP)
EMAIL_FROM="LeadPulse <noreply@leadpulse.dev>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ── File storage ────────────────────────────────────────────────
STORAGE_DRIVER=local                     # local | supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=               # server-side only, never in the client
SUPABASE_BUCKET=leadpulse

# ── Seed ────────────────────────────────────────────────────────
SEED_DEMO=true

# ── Client (Vite) — set in client/.env or the Vercel project ────
# Leave empty in dev: the Vite dev server proxies /api and /socket.io.
VITE_API_URL=
VITE_SOCKET_URL=
# VITE_PROXY_TARGET=http://localhost:3001  # dev proxy target (compose sets http://server:3001)
