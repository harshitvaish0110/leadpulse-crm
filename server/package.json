{
  "name": "leadpulse-server",
  "version": "1.0.0",
  "description": "LeadPulse CRM — Node.js API server",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node prisma/seed.js",
    "migrate": "npx prisma migrate dev",
    "migrate:reset": "npx prisma migrate reset --force",
    "generate": "npx prisma generate",
    "studio": "npx prisma studio",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.js\"",
    "worker": "node worker.js",
    "worker:dev": "nodemon worker.js",
    "job": "node src/queues/jobs.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@google/genai": "^2.10.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "groq-sdk": "^1.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
